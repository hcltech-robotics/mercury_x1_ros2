<?xml version="1.0" encoding="UTF-8"?>
<!-- Mercury X1 semantic description for MoveIt. The URDF root is base_footprint (planning frame).
     Arm chains hang off link_body (the torso, turned by the waist joint "body"); the *_waist groups add the
     waist so a reach can use it. Head (neck "head", jaw "eye") is not planned: the pages move it directly.
     disable_collisions below: generated by collisions_updater (see README), do not edit by hand. -->
<robot name="mercury_x1">
  <group name="left_arm">
    <chain base_link="link_body" tip_link="link7_L"/>
  </group>
  <group name="right_arm">
    <chain base_link="link_body" tip_link="link7_R"/>
  </group>
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>
  <group name="waist">
    <joint name="body"/>
  </group>
  <group name="left_arm_waist">
    <chain base_link="base_link" tip_link="link7_L"/>
  </group>
  <group name="right_arm_waist">
    <chain base_link="base_link" tip_link="link7_R"/>
  </group>

  <!-- arms hanging at the sides (read from the robot 2026-11-02) -->
  <group_state name="rest" group="both_arms">
    <joint name="joint1_L" value="1.709"/>
    <joint name="joint2_L" value="1.419"/>
    <joint name="joint3_L" value="-1.199"/>
    <joint name="joint4_L" value="-0.581"/>
    <joint name="joint5_L" value="-0.286"/>
    <joint name="joint6_L" value="0.264"/>
    <joint name="joint7_L" value="1.166"/>
    <joint name="joint1_R" value="-1.759"/>
    <joint name="joint2_R" value="1.641"/>
    <joint name="joint3_R" value="1.710"/>
    <joint name="joint4_R" value="-0.539"/>
    <joint name="joint5_R" value="-1.122"/>
    <joint name="joint6_R" value="0.559"/>
    <joint name="joint7_R" value="0.497"/>
  </group_state>
  <group_state name="straight" group="waist">
    <joint name="body" value="0"/>
  </group_state>

  <!-- the flanges carry no tool yet (no gripper model) -->
  <end_effector name="left_flange" parent_link="link7_L" group="left_arm"/>
  <end_effector name="right_flange" parent_link="link7_R" group="right_arm"/>

  <!-- self-collision matrix: make_acm.py, 200016 poses -->
  <disable_collisions link1="base_link" link2="link1_L" reason="Never"/>
  <disable_collisions link1="base_link" link2="link1_R" reason="Never"/>
  <disable_collisions link1="base_link" link2="link2_L" reason="Never"/>
  <disable_collisions link1="base_link" link2="link2_R" reason="Never"/>
  <disable_collisions link1="base_link" link2="link_body" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link_eye" reason="Never"/>
  <disable_collisions link1="base_link" link2="link_head" reason="Never"/>
  <disable_collisions link1="link1_L" link2="link1_R" reason="Never"/>
  <disable_collisions link1="link1_L" link2="link2_L" reason="Adjacent"/>
  <disable_collisions link1="link1_L" link2="link2_R" reason="Never"/>
  <disable_collisions link1="link1_L" link2="link3_L" reason="Never"/>
  <disable_collisions link1="link1_L" link2="link3_R" reason="Never"/>
  <disable_collisions link1="link1_L" link2="link4_L" reason="Never"/>
  <disable_collisions link1="link1_L" link2="link4_R" reason="Never"/>
  <disable_collisions link1="link1_L" link2="link5_L" reason="Never"/>
  <disable_collisions link1="link1_L" link2="link_body" reason="Adjacent"/>
  <disable_collisions link1="link1_L" link2="link_eye" reason="Never"/>
  <disable_collisions link1="link1_L" link2="link_head" reason="Never"/>
  <disable_collisions link1="link1_R" link2="link2_L" reason="Never"/>
  <disable_collisions link1="link1_R" link2="link2_R" reason="Adjacent"/>
  <disable_collisions link1="link1_R" link2="link3_L" reason="Never"/>
  <disable_collisions link1="link1_R" link2="link3_R" reason="Never"/>
  <disable_collisions link1="link1_R" link2="link4_L" reason="Never"/>
  <disable_collisions link1="link1_R" link2="link4_R" reason="Never"/>
  <disable_collisions link1="link1_R" link2="link5_R" reason="Never"/>
  <disable_collisions link1="link1_R" link2="link_body" reason="Adjacent"/>
  <disable_collisions link1="link1_R" link2="link_eye" reason="Never"/>
  <disable_collisions link1="link1_R" link2="link_head" reason="Never"/>
  <disable_collisions link1="link2_L" link2="link2_R" reason="Never"/>
  <disable_collisions link1="link2_L" link2="link3_L" reason="Adjacent"/>
  <disable_collisions link1="link2_L" link2="link3_R" reason="Never"/>
  <disable_collisions link1="link2_L" link2="link5_L" reason="Never"/>
  <disable_collisions link1="link2_L" link2="link_eye" reason="Never"/>
  <disable_collisions link1="link2_R" link2="link3_L" reason="Never"/>
  <disable_collisions link1="link2_R" link2="link3_R" reason="Adjacent"/>
  <disable_collisions link1="link2_R" link2="link5_R" reason="Never"/>
  <disable_collisions link1="link2_R" link2="link_eye" reason="Never"/>
  <disable_collisions link1="link3_L" link2="link4_L" reason="Adjacent"/>
  <disable_collisions link1="link3_L" link2="link6_L" reason="Never"/>
  <disable_collisions link1="link3_L" link2="link7_L" reason="Never"/>
  <disable_collisions link1="link3_L" link2="link_eye" reason="Never"/>
  <disable_collisions link1="link3_R" link2="link4_R" reason="Adjacent"/>
  <disable_collisions link1="link3_R" link2="link6_R" reason="Never"/>
  <disable_collisions link1="link3_R" link2="link7_R" reason="Never"/>
  <disable_collisions link1="link3_R" link2="link_eye" reason="Never"/>
  <disable_collisions link1="link4_L" link2="link5_L" reason="Adjacent"/>
  <disable_collisions link1="link4_L" link2="link6_L" reason="Never"/>
  <disable_collisions link1="link4_L" link2="link7_L" reason="Never"/>
  <disable_collisions link1="link4_R" link2="link5_R" reason="Adjacent"/>
  <disable_collisions link1="link4_R" link2="link6_R" reason="Never"/>
  <disable_collisions link1="link4_R" link2="link7_R" reason="Never"/>
  <disable_collisions link1="link5_L" link2="link6_L" reason="Adjacent"/>
  <disable_collisions link1="link5_R" link2="link6_R" reason="Adjacent"/>
  <disable_collisions link1="link6_L" link2="link7_L" reason="Adjacent"/>
  <disable_collisions link1="link6_R" link2="link7_R" reason="Adjacent"/>
  <disable_collisions link1="link_body" link2="link_eye" reason="Always"/>
  <disable_collisions link1="link_body" link2="link_head" reason="Adjacent"/>
  <disable_collisions link1="link_eye" link2="link_head" reason="Adjacent"/>
  <!-- end self-collision matrix -->
</robot>
