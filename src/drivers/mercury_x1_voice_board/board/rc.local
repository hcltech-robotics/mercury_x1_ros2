#!/bin/sh

# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# hpout playback
amixer -D hw:audiocodec cset name='Headphone Switch' 1
amixer -D hw:audiocodec cset name='Headphone Volume' 3
amixer -D hw:audiocodec cset name='HpSpeaker Switch' 1

# lineout playback
amixer -D hw:audiocodec cset name='LINEOUT Output Select' 'DAC_DIFFER'
amixer -D hw:audiocodec cset name='LINEOUT Switch' 1
amixer -D hw:audiocodec cset name='LINEOUT volume' 20

amixer -D hw:audiocodec cset name='ADCL Input MIC1 Boost Switch' 1
amixer -D hw:audiocodec cset name='ADCR Input MIC2 Boost Switch' 1
amixer -D hw:audiocodec cset name='MIC1 gain volume' 12
amixer -D hw:audiocodec cset name='MIC2 gain volume' 12

# mic capture
amixer -D hw:sndac10710036 cset name='Channel 1 PGA Gain' 20
amixer -D hw:sndac10710036 cset name='Channel 2 PGA Gain' 20

if [ ! -d /sys/kernel/config/usb_gadget ]; then
	mount -t configfs none /sys/kernel/config
	mkdir /sys/kernel/config/usb_gadget/g1
	mkdir /sys/kernel/config/usb_gadget/g1/strings/0x409
	echo "Allwinner" > /sys/kernel/config/usb_gadget/g1/strings/0x409/manufacturer
	echo "Tina" > /sys/kernel/config/usb_gadget/g1/strings/0x409/product
fi

if [ ! -d /sys/kernel/config/usb_gadget/g1/configs/c.1 ]; then
	mkdir /sys/kernel/config/usb_gadget/g1/configs/c.1
	echo 0xc0 > /sys/kernel/config/usb_gadget/g1/configs/c.1/bmAttributes
	echo 500 > /sys/kernel/config/usb_gadget/g1/configs/c.1/MaxPower
	mkdir /sys/kernel/config/usb_gadget/g1/configs/c.1/strings/0x409
fi

rm -f /sys/kernel/config/usb_gadget/g1/configs/c.1/ffs.adb
rm -f /sys/kernel/config/usb_gadget/g1/configs/c.1/uac1.usb0

echo 0x2207 > /sys/kernel/config/usb_gadget/g1/idVendor
echo 0x0001 > /sys/kernel/config/usb_gadget/g1/idProduct
echo "XFM-DP-V0.0.18" > /sys/kernel/config/usb_gadget/g1/strings/0x409/product
echo "iflytek" > /sys/kernel/config/usb_gadget/g1/strings/0x409/manufacturer

if [ ! -d /sys/kernel/config/usb_gadget/g1/functions/ffs.adb ]; then
	mkdir /sys/kernel/config/usb_gadget/g1/functions/ffs.adb
#	ln -s /sys/kernel/config/usb_gadget/g1/functions/ffs.adb/ /sys/kernel/config/usb_gadget/g1/configs/c.1/ffs.adb
fi

if [ ! -d /sys/kernel/config/usb_gadget/g1/functions/uac1.usb0 ]; then
	mkdir /sys/kernel/config/usb_gadget/g1/functions/uac1.usb0
	echo 0 > /sys/kernel/config/usb_gadget/g1/functions/uac1.usb0/c_chmask
	# Mercury X1: 6 channels to the host (4 mics, echo reference, processed beam; see /etc/asound.conf).
	# 6 x 16 kHz x 2 B = 192 B/ms fits the driver's fixed 200-byte packets; 8 channels would not.
	echo 0x3f > /sys/kernel/config/usb_gadget/g1/functions/uac1.usb0/p_chmask
	#ln -s /sys/kernel/config/usb_gadget/g1/functions/uac1.usb0/ /sys/kernel/config/usb_gadget/g1/configs/c.1/uac1.usb0
fi

ln -s /sys/kernel/config/usb_gadget/g1/functions/ffs.adb/ /sys/kernel/config/usb_gadget/g1/configs/c.1/ffs.adb
ln -s /sys/kernel/config/usb_gadget/g1/functions/uac1.usb0/ /sys/kernel/config/usb_gadget/g1/configs/c.1/uac1.usb0

udc=`ls /sys/class/udc`
echo $udc > /sys/kernel/config/usb_gadget/g1/UDC

sleep 1

# Mercury X1: raw mic channels -> USB (stock arecord/aplay, see /data/build/rawmic.sh)
[ -x /data/build/rawmic.sh ] && start-stop-daemon -S -b -x /data/build/rawmic.sh
# Mercury X1: our mic-array front end instead of the demo (scripts/install_voicefront.sh; absent = stock demo)
[ -x /data/build/voicefront/voicefront.sh ] && start-stop-daemon -S -b -x /data/build/voicefront/voicefront.sh

exit 0
