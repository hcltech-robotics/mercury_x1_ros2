# Mercury X1 speech (Kokoro on the Jetson GPU) for the head display's voice chat: http://127.0.0.1:8097/tts
# Install / remove with server/robot_tts/setup.sh. Logs: journalctl -u mercury-tts
[Unit]
Description=Mercury X1 speech synthesis (Kokoro, GPU)
After=network.target

[Service]
User=elephant
WorkingDirectory=/home/elephant/mercury-tts
ExecStart=/home/elephant/mercury-tts/.venv/bin/python /home/elephant/mercury_x1_ros2/server/robot_tts/tts_service.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
