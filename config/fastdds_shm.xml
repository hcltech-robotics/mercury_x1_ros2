<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast-DDS profile for the Mercury X1. The default shared-memory segment (512 KB) is smaller than one
     640x480 colour (921 KB) or depth (614 KB) image, so those fell back to fragmented UDP over loopback and
     about half of the frames were lost. A 16 MB segment keeps whole images in shared memory. UDP stays
     enabled for other machines (Rerun/RViz on the LAN, the dimos viewer). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_big</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
      <maxMessageSize>16777216</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>4194304</sendBufferSize>
      <receiveBufferSize>4194304</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="mx1_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_big</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
