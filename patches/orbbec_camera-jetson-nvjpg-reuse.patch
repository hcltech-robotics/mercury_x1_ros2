From 045767aeeecf4b1bd5a6645cc2033d2e6d4fb4ab Mon Sep 17 00:00:00 2001
From: Konstantin Severov <legion1581@gmail.com>
Date: Thu, 29 Oct 2026 17:19:10 -0700
Subject: [PATCH] Jetson NVJPG decoder: reuse decoder and RGBA surface across
 frames, honour pitch

Creating NvJPEGDecoder and allocating the RGBA NvBufSurface for every frame made the
hardware path slower than CPU decoding (colour ~2 Hz on Orin Nano).
---
 .../include/orbbec_camera/jetson_nv_decoder.h |  4 +-
 orbbec_camera/src/jetson_nv_decoder.cpp       | 65 ++++++++++---------
 2 files changed, 38 insertions(+), 31 deletions(-)

diff --git a/orbbec_camera/include/orbbec_camera/jetson_nv_decoder.h b/orbbec_camera/include/orbbec_camera/jetson_nv_decoder.h
index 2aea7415..d30f5694 100644
--- a/orbbec_camera/include/orbbec_camera/jetson_nv_decoder.h
+++ b/orbbec_camera/include/orbbec_camera/jetson_nv_decoder.h
@@ -33,6 +33,8 @@ class JetsonNvJPEGDecoder : public JPEGDecoder {
   bool decode(const std::shared_ptr<ob::ColorFrame>& frame, uint8_t* dest) override;
 
  private:
-  NvJPEGDecoder* decoder_;
+  // created once and reused: opening the NVJPG block per frame costs more than CPU decoding
+  NvJPEGDecoder* decoder_ = nullptr;
+  int rgba_fd_ = -1;  // persistent RGBA surface for the VIC colour conversion
 };
 }  // namespace orbbec_camera
\ No newline at end of file
diff --git a/orbbec_camera/src/jetson_nv_decoder.cpp b/orbbec_camera/src/jetson_nv_decoder.cpp
index 16967cc0..04def23d 100644
--- a/orbbec_camera/src/jetson_nv_decoder.cpp
+++ b/orbbec_camera/src/jetson_nv_decoder.cpp
@@ -29,7 +29,12 @@ namespace orbbec_camera {
 
 JetsonNvJPEGDecoder::JetsonNvJPEGDecoder(int width, int height) : JPEGDecoder(width, height) {}
 
-JetsonNvJPEGDecoder::~JetsonNvJPEGDecoder() { delete decoder_; }
+JetsonNvJPEGDecoder::~JetsonNvJPEGDecoder() {
+  if (rgba_fd_ != -1) {
+    NvBufSurf::NvDestroy(rgba_fd_);
+  }
+  delete decoder_;
+}
 
 bool JetsonNvJPEGDecoder::decode(const std::shared_ptr<ob::ColorFrame> &frame, uint8_t *dest) {
   if (!isValidJPEG(frame)) {
@@ -44,39 +49,45 @@ bool JetsonNvJPEGDecoder::decode(const std::shared_ptr<ob::ColorFrame> &frame, u
   while (data_size > 4 && data[data_size - 1] == 0x00) {
     data_size--;
   }
+  // fd is owned by the decoder (its output buffer); it must not be closed here
   int fd = -1;
-  decoder_ = NvJPEGDecoder::createJPEGDecoder("jpegdec");
-  std::shared_ptr<int> decoder_deleter(nullptr, [&](int *) { delete decoder_; });
-  decoder_->decodeToFd(fd, data, data_size, pixfmt, width, height);
+  if (decoder_ == nullptr) {
+    decoder_ = NvJPEGDecoder::createJPEGDecoder("jpegdec");
+    if (decoder_ == nullptr) {
+      RCLCPP_ERROR_STREAM(rclcpp::get_logger("jetson_nv_decoder"), "Failed to create NvJPEGDecoder");
+      return false;
+    }
+  }
+  if (decoder_->decodeToFd(fd, data, data_size, pixfmt, width, height) < 0 || fd == -1) {
+    RCLCPP_ERROR_STREAM(rclcpp::get_logger("jetson_nv_decoder"), "decodeToFd failed");
+    return false;
+  }
   if (pixfmt != V4L2_PIX_FMT_YUV422M) {
     RCLCPP_ERROR_STREAM(rclcpp::get_logger("jetson_nv_decoder"), "Unexpected pixfmt: " << pixfmt);
-    if (fd != -1) {
-      close(fd);
-    }
     return false;
   }
   if (width != static_cast<uint32_t>(width_) || height != static_cast<uint32_t>(height_)) {
     RCLCPP_ERROR_STREAM(rclcpp::get_logger("jetson_nv_decoder"),
                         "Unexpected width/height: " << width << "x" << height);
-    if (fd != -1) {
-      close(fd);
-    }
     return false;
   }
-  NvBufSurf::NvCommonAllocateParams nvbufParams;
-  memset(&nvbufParams, 0, sizeof(nvbufParams));
-
-  nvbufParams.memType = NVBUF_MEM_SURFACE_ARRAY;
-  nvbufParams.width = width;
-  nvbufParams.height = height;
-  nvbufParams.layout = NVBUF_LAYOUT_PITCH;
-  nvbufParams.colorFormat = NVBUF_COLOR_FORMAT_RGBA;
-  int rgba_fd = -1;
-  int ret = NvBufSurf::NvAllocate(&nvbufParams, 1, &rgba_fd);
-  if (ret != 0) {
-    RCLCPP_ERROR_STREAM(rclcpp::get_logger("jetson_nv_decoder"), "Failed to allocate buffer");
-    return false;
+  int ret = 0;
+  if (rgba_fd_ == -1) {
+    NvBufSurf::NvCommonAllocateParams nvbufParams;
+    memset(&nvbufParams, 0, sizeof(nvbufParams));
+    nvbufParams.memType = NVBUF_MEM_SURFACE_ARRAY;
+    nvbufParams.width = width;
+    nvbufParams.height = height;
+    nvbufParams.layout = NVBUF_LAYOUT_PITCH;
+    nvbufParams.colorFormat = NVBUF_COLOR_FORMAT_RGBA;
+    ret = NvBufSurf::NvAllocate(&nvbufParams, 1, &rgba_fd_);
+    if (ret != 0) {
+      rgba_fd_ = -1;
+      RCLCPP_ERROR_STREAM(rclcpp::get_logger("jetson_nv_decoder"), "Failed to allocate buffer");
+      return false;
+    }
   }
+  const int rgba_fd = rgba_fd_;
   NvBufSurf::NvCommonTransformParams transform_params;
   transform_params.src_top = 0;
   transform_params.src_left = 0;
@@ -92,9 +103,6 @@ bool JetsonNvJPEGDecoder::decode(const std::shared_ptr<ob::ColorFrame> &frame, u
   ret = NvBufSurf::NvTransform(&transform_params, fd, rgba_fd);
   if (ret != 0) {
     RCLCPP_ERROR_STREAM(rclcpp::get_logger("jetson_nv_decoder"), "Failed to transform buffer");
-    if (rgba_fd != -1) {
-      NvBufSurf::NvDestroy(rgba_fd);
-    }
     return false;
   }
   NvBufSurface *nvbuf_surf = 0;
@@ -106,14 +114,11 @@ bool JetsonNvJPEGDecoder::decode(const std::shared_ptr<ob::ColorFrame> &frame, u
   }
   NvBufSurfaceSyncForCpu(nvbuf_surf, 0, 0);
   uint8_t *rgba = (uint8_t *)nvbuf_surf->surfaceList[0].mappedAddr.addr[0];
-  int src_stride_argb = width * 4;
+  const int src_stride_argb = static_cast<int>(nvbuf_surf->surfaceList[0].planeParams.pitch[0]);
   int dst_stride_rgb24 = width * 3;
 
   libyuv::ARGBToRGB24(rgba, src_stride_argb, dest, dst_stride_rgb24, width, height);
   NvBufSurfaceUnMap(nvbuf_surf, 0, 0);
-  if (rgba_fd != -1) {
-    NvBufSurf::NvDestroy(rgba_fd);
-  }
   return true;
 }
 }  // namespace orbbec_camera
-- 
2.34.1

