[Unit]
Description=Mercury X1 speech service (Whisper STT on GPU) on :8096
After=network-online.target docker.service

[Service]
User=hcltech
WorkingDirectory=/home/hcltech/mercury-voice
# PENNY_API_KEY: the same bearer token as the model
EnvironmentFile=/home/hcltech/pennyroyal/docker/pennyroyal/.env
Environment=VOICE_PORT=8096
# models are cached in ~/.cache/huggingface: no network check at start
Environment=HF_HUB_OFFLINE=1
# Kokoro TTS here is off: the robot speaks on its own GPU (server/robot_tts); VOICE_TTS=1 turns it back on
Environment=VOICE_TTS=0
ExecStart=/home/hcltech/mercury-voice/run.sh
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
